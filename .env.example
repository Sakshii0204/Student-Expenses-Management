# ========================================================
# Student Expense Management System
# Unified Environment Configuration Template (Phase 2)
# ========================================================

# Integrated Express Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/student_expense_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student_expense_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_expense_db

# Cryptographic Authentication Secrets (MANDATORY)
# WARNING: Server will refuse to boot if JWT_SECRET is unset.
JWT_SECRET=change_this_to_a_cryptographically_secure_key_in_production
JWT_EXPIRES_IN=7d

# Unified Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
